# Database
DATABASE_URL=postgresql://user:password@localhost:5432/veilend

# Auth / Sessions
JWT_SECRET=change_me_in_production

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=200
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=15

# CORS — comma-separated list of allowed production origins
# e.g. CORS_ORIGINS=https://app.veilend.xyz,https://www.veilend.xyz
CORS_ORIGINS=

# Stellar / Soroban
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_CONTRACT_ID=
STELLAR_INDEXER_START_LEDGER=1
STELLAR_INDEXER_POLL_INTERVAL_MS=5000

# Admin actions (unsigned XDR handoff + watcher)
ADMIN_ACTION_WATCHER_POLL_INTERVAL_MS=10000

# Application
PORT=3001
NODE_ENV=development
