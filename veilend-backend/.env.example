# ─────────────────────────────────────────────────────────────
# VeilLend Backend – environment template
# Copy to `.env` and adjust for your machine:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# HTTP
PORT=3000

# PostgreSQL (Prisma)
# Docker Compose defaults: postgresql://veilend:veilend@localhost:5432/veilend
DATABASE_URL=postgresql://user:password@localhost:5432/veilend

# Auth / sessions (required in production — never commit real secrets)
JWT_SECRET=change_me_in_production

# Rate limiting (Nest Throttler; TTL in milliseconds)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5

# Stellar network (defaults target public testnet)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Indexer (optional until a contract is deployed)
STELLAR_CONTRACT_ID=CCW57ZST4NV43YS7JZKMGLG62624NV43YS7JZKMGLG62624NV43YS7JZ
STELLAR_INDEXER_START_LEDGER=1
STELLAR_INDEXER_POLL_INTERVAL_MS=5000

# Optional: POST JSON error events on 5xx (leave blank to disable)
# ERROR_MONITORING_WEBHOOK=https://hooks.example.com/veilend-errors
