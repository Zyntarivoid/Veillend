generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  createdAt     DateTime @default(now())

  positions            Position[]
  transactions         TransactionHistory[]
  sessions             Session[]
  refreshTokens        RefreshToken[]
  jtiRegistrations     JtiRegistry[]
  syncCheckpoints      SyncCheckpoint[]
  pushTokens           PushToken[]
  notifications        UserNotification[]
  notificationSettings NotificationSettings?
  e2eePublicKey        UserE2eePublicKey?
  deposits             UserDeposit[]
  withdrawals          WithdrawalRequest[]
  addressWhitelist     AddressWhitelist[]
}

model WalletNonce {
  id            String   @id @default(uuid())
  walletAddress String
  nonce         String
  expiresAt     DateTime
  used          Boolean  @default(false)
}

// A logical "device login" that persists across access-token refreshes.
// The bearer token presented on `Authorization` rotates every 15 minutes
// (see RefreshToken/JtiRegistry below); this row is what GET /auth/sessions
// lists and what DELETE /auth/sessions[/:id] revokes.
model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique // most recently issued access token (informational; new-format
  // tokens are authorized via JtiRegistry, not this field)
  expiresAt  DateTime // expiry of `token` above
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  refreshTokens RefreshToken[]
  jtis          JtiRegistry[]

  @@index([userId])
  @@index([token])
}

// One-time-use opaque refresh token (never a JWT). Each successful refresh
// revokes the token it was exchanged with and mints a new pair, so a given
// row's lifecycle is: created -> (optionally) revoked when rotated or
// explicitly logged out. A revoked row is kept (not deleted) so a replay of
// it can be told apart from a token that never existed, which is what lets
// `AuthService.refreshTokens` detect refresh-token-family compromise.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique // SHA-256 of the opaque token; the raw token is never stored
  jti           String // jti of the access token minted alongside this refresh token
  familyId      String // rotation-chain identifier; all tokens in one chain share this
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  lastRotatedAt DateTime  @default(now())
  revokedAt     DateTime?
  userAgent     String?
  ip            String?

  @@index([userId])
  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
}

// Revocation registry for access-token `jti` claims. Every new-format access
// token gets a row here at issue time (same transaction as the Session /
// RefreshToken it's paired with); JwtStrategy checks it on every request so
// a single access token — not just its parent session — can be revoked
// immediately instead of waiting out its 15-minute TTL.
model JtiRegistry {
  jti       String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

// ─── Stellar Assets ──────────────────────────────────────────────────────────

// Represents a Stellar Classic or Soroban token asset
model Asset {
  id                 String   @id @default(uuid())
  code               String // e.g. "USDC", "XLM"
  issuer             String? // null for native XLM
  contractId         String?  @unique // Soroban token contract address
  decimals           Int      @default(7)
  symbol             String // display ticker
  name               String
  displayName        String? // human-friendly admin name
  logoUrl            String?
  isNative           Boolean  @default(false)
  isSupported        Boolean  @default(false) // set by the indexer's 'asset_configured' event
  verified           Boolean  @default(false)
  minCollateralRatio Float? // per-asset LTV (0–1); null uses protocol default
  createdAt          DateTime @default(now())

  positions            Position[]
  transactions         TransactionHistory[]
  deposits             UserDeposit[]
  withdrawals          WithdrawalRequest[]
  withdrawalConfig     AssetWithdrawalConfig?
  interestState        AssetInterestState?
  interestParams       AssetInterestParams?

  @@unique([code, issuer])
  @@index([contractId])
}

// ─── Positions ───────────────────────────────────────────────────────────────

// A user's active lending/borrowing position in the VeilLend protocol
model Position {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  // Raw on-chain amounts in the asset's native precision
  depositedRaw       BigInt @default(0) // collateral supplied
  borrowedRaw        BigInt @default(0) // outstanding debt
  accruedInterestRaw BigInt @default(0)

  // Interest tracking snapshots (ray 1e27 typically, or whatever scale contract uses, we'll use Decimal)
  borrowIndexSnapshot Decimal @default(1.0) @db.Decimal(28, 9)
  supplyIndexSnapshot Decimal @default(1.0) @db.Decimal(28, 9)

  // Derived USD values cached from last sync (7 decimal places)
  depositedUsd Decimal @default(0) @db.Decimal(28, 7)
  borrowedUsd  Decimal @default(0) @db.Decimal(28, 7)

  // Risk metrics
  collateralFactor     Decimal  @default(0) @db.Decimal(5, 4) // 0.0000–1.0000
  liquidationThreshold Decimal  @default(0) @db.Decimal(5, 4)
  healthFactor         Decimal? @db.Decimal(10, 4) // null when no debt

  // Privacy mode flag (balances hidden in UI but still tracked)
  privacyMode Boolean @default(false)

  // Sync metadata
  lastSyncLedger Int? // Stellar ledger sequence
  lastSyncAt     DateTime?
  isStale        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, assetId])
  @@index([userId])
  @@index([assetId])
  @@index([lastSyncAt])
}

// ─── Transaction History ─────────────────────────────────────────────────────

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BORROW
  REPAY
  LIQUIDATION
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model TransactionHistory {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  type   TransactionType
  status TransactionStatus @default(PENDING)

  amountRaw BigInt // in asset native precision
  amountUsd Decimal @db.Decimal(28, 7)

  // Stellar identifiers
  txHash         String? // Stellar transaction hash
  eventIndex     Int? // Event index within transaction
  ledgerSequence Int? // ledger it was included in
  operationId    String? // Stellar operation ID

  // Soroban-specific
  contractId     String? // contract that emitted the event
  sorobanEventId String? @unique // Soroban event id; the true per-event idempotency key (a txHash can contain multiple events)

  memo        String?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@unique([txHash, eventIndex])
  @@index([userId, createdAt])
  @@index([assetId])
  @@index([txHash])
  @@index([ledgerSequence])
  @@index([sorobanEventId])
}

// ─── Sync Checkpoints ────────────────────────────────────────────────────────

// Tracks the last successfully processed ledger per user for incremental sync
model SyncCheckpoint {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The Stellar ledger sequence number we've synced up to
  lastLedger   Int       @default(0)
  lastLedgerAt DateTime?

  // Soroban event cursor for resumable event streaming
  eventCursor String?

  syncStatus String   @default("idle") // idle | running | error
  lastError  String?
  updatedAt  DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
}

model Admin {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  createdAt     DateTime @default(now())

  @@index([walletAddress])
}

// ─── Admin Audit Log ─────────────────────────────────────────────────────────

enum AdminActionType {
  ADD_ADMIN
  REMOVE_ADMIN
  CONFIGURE_ASSET
  SET_ORACLE_PRICE
  SET_MIN_COLLATERAL_RATIO
  INDEXER_REPLAY
}

model AdminAuditLog {
  id          String          @id @default(uuid())
  actorWallet String // wallet address of the admin who performed the action
  action      AdminActionType
  target      String? // the target of the action (e.g., wallet address, asset ID)
  payload     Json? // additional data about the action
  createdAt   DateTime        @default(now())

  @@index([actorWallet])
  @@index([action])
  @@index([createdAt])
}

// ─── Admin Action Intents ────────────────────────────────────────────────────

enum AdminActionStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
}

// Records every privileged admin mutation dispatched through the backend as a
// replay-safe intent. The backend never holds admin secret keys: it builds an
// unsigned Soroban transaction XDR (source = admin's public key, sequence =
// the admin account's current nonce, memo = the action id) that the client
// signs with Freighter and submits itself. The AdminActionWatcher flips the
// status based on the on-chain outcome of the reported txHash.
model AdminAction {
  id           String            @id @default(cuid())
  adminAddress String
  action       AdminActionType
  payload      Json
  xdr          String            @default("")
  status       AdminActionStatus @default(PENDING)
  txHash       String?           @unique
  error        String?
  submittedAt  DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([adminAddress])
  @@index([action])
  @@index([status])
  @@index([txHash])
}

// ─── Auth Audit Log ──────────────────────────────────────────────────────────

enum AuthEventType {
  NONCE_GENERATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESH
  TOKEN_REFRESH_REUSE_DETECTED
  SESSION_REVOKED
  SESSION_REVOKE_ALL
}

model AuthAuditLog {
  id            String        @id @default(uuid())
  walletAddress String
  event         AuthEventType
  reason        String?
  ip            String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime      @default(now())

  @@index([walletAddress, createdAt(sort: Desc)])
}

// ─── Indexer Checkpoint ──────────────────────────────────────────────────────

// Singleton row (fixed id "global") tracking the Soroban event indexer's
// global ledger cursor. Distinct from SyncCheckpoint, which is scoped
// per-user for a different purpose.
model IndexerCheckpoint {
  id                String   @id @default("global")
  lastIndexedLedger Int      @default(0)
  updatedAt         DateTime @updatedAt
}

// ─── Indexer Event Deduplication Lookaside ───────────────────────────────────

model IndexerEventDedup {
  id         String   @id @default(uuid())
  eventId    String   @unique
  txHash     String?
  eventIndex Int?
  ledger     Int?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@index([eventId])
  @@index([txHash, eventIndex])
}

// ─── Push Notifications ──────────────────────────────────────────────────────

enum Platform {
  IOS
  ANDROID
}

enum NotificationKind {
  LIQUIDATION_RISK
  LIQUIDATION_OPPORTUNITY
  ONBOARDING
  IDLE_LOCK
  GENERAL_ANNOUNCEMENT
  MARKETING
  SECURITY_ALERT
}

// One row per registered device. `token` is globally unique (Expo push
// tokens are device-scoped); re-registering the same token reassigns it to
// whichever user is currently signed in on that device.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  Platform
  locale    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Per-user notification channel preferences. Singleton row (userId is the
// PK), created lazily on first read/write. `lastLiquidationPushAt` backs the
// 1-push-per-hour liquidation cooldown so a health factor oscillating around
// the risk threshold doesn't spam the user.
model NotificationSettings {
  userId                 String    @id
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  liquidationRisk        Boolean   @default(true)
  liquidationOpportunity Boolean   @default(true)
  generalAnnouncements   Boolean   @default(true)
  marketing              Boolean   @default(false)
  security               Boolean   @default(true)
  lastLiquidationPushAt  DateTime?
  updatedAt              DateTime  @updatedAt
}

// In-app notification history. Written unconditionally for every notify
// attempt regardless of whether a push was actually sent (channel disabled,
// rate-limited, no device token, etc.), so the in-app inbox is always
// complete. `payload` holds the plaintext title/body/data — this is our own
// database, not a 3rd-party push service, so no E2EE is needed here.
model UserNotification {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            NotificationKind
  payload         Json
  readAt          DateTime?
  pushDeliveredAt DateTime?
  createdAt       DateTime         @default(now())

  @@index([userId, createdAt])
}

// The user's Curve25519 public key (nacl.box), set from the mobile app,
// which holds the matching private key in SecureStore. Sensitive push kinds
// (liquidation risk/opportunity) are encrypted to this key before being
// handed to Expo, so the push payload observed by Expo/Apple/Google never
// contains plaintext balances or health factors.
model UserE2eePublicKey {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Deposit Safety Rails ────────────────────────────────────────────────────

enum DepositStatus {
  PENDING
  CONFIRMED
  ORPHANED
}

// Tracks inbound on-chain token transfers a user has made, waiting for ledger
// confirmations before crediting the off-chain balance. Prevents double-spend
// via race by requiring minConfirmations before marking CONFIRMED.
model UserDeposit {
  id                     String        @id @default(uuid())
  userWallet             String
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId                String
  asset                  Asset         @relation(fields: [assetId], references: [id])
  amountStroops          BigInt
  txHash                 String        @unique
  ledgerSeq              Int
  confirmationsRequired  Int           @default(5)
  confirmationsSeen      Int           @default(0)
  status                 DepositStatus @default(PENDING)
  createdAt              DateTime      @default(now())
  creditedAt             DateTime?

  @@index([userWallet])
  @@index([userId])
  @@index([assetId])
  @@index([status])
  @@index([txHash])
  @@index([ledgerSeq])
  @@index([createdAt])
}

// ─── Withdrawal Safety Rails ─────────────────────────────────────────────────

enum WithdrawalStatus {
  DRAFT
  SIGNED
  SENT
  CONFIRMED
  REJECTED
  CANCELLED
  ORPHANED
  REQUIRES_REVALIDATION
}

// A user-initiated withdrawal request. Flows through: DRAFT → SIGNED →
// SENT → CONFIRMED (or REJECTED/ORPHANED on failure). The backend builds
// the XDR and asks the user to sign with their wallet. After submission,
// the watcher waits for Stellar ledger confirmations before marking complete.
model WithdrawalRequest {
  id                     String           @id @default(uuid())
  userWallet             String
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId                String
  asset                  Asset            @relation(fields: [assetId], references: [id])
  amountStroops          BigInt
  destinationAddress     String
  destinationTag         String?
  whitelistApproved      Boolean          @default(false)
  whitelistEntryAddedAt  DateTime?
  timelockUntil          DateTime?
  status                 WithdrawalStatus @default(DRAFT)
  xdr                    String           @default("")
  txHash                 String?          @unique
  feeChargedStroops      BigInt?
  confirmationsRequired  Int              @default(5)
  confirmationsSeen      Int              @default(0)
  error                  String?
  contractErrorCode      Int?
  healthFactorAtCreation Decimal?         @db.Decimal(10, 4)
  lastHealthCheckAt      DateTime?
  idempotencyKey         String?
  createdAt              DateTime         @default(now())
  signedAt               DateTime?
  submittedAt            DateTime?
  confirmedAt            DateTime?

  nonces                 WithdrawNonce[]

  @@unique([userId, idempotencyKey])
  @@index([userWallet])
  @@index([userId])
  @@index([assetId])
  @@index([status])
  @@index([txHash])
  @@index([idempotencyKey])
  @@index([createdAt])
}

// ─── Withdrawal Nonce (replay guard) ─────────────────────────────────────────

// Every WithdrawalRequest has a UNIQUE WithdrawNonce embedded as a memo+hash.
// If the same signed payload is replayed, the backend rejects because the
// nonce is already used. Matches the B20 admin idempotency pattern.
model WithdrawNonce {
  id                String   @id @default(uuid())
  nonce             String   @unique // SHA-256 hash of the memo embedded in the XDR
  withdrawalRequestId String  @unique
  withdrawalRequest WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)
  used              Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([nonce])
  @@index([used])
}

// ─── Idempotency ─────────────────────────────────────────────────────────────

model IdempotencyKey {
  id            String   @id @default(uuid())
  key           String   @unique
  userId        String
  endpoint      String   // e.g. "POST /withdrawals", "POST /deposits"
  responseJson  Json     // the original response body
  statusCode    Int      // the original HTTP status code
  createdAt     DateTime @default(now())
  expiresAt     DateTime // 24 hours after creation

  @@index([key])
  @@index([userId, endpoint])
  @@index([expiresAt])
}

// ─── Address Whitelist ───────────────────────────────────────────────────────

// User's whitelisted withdrawal addresses. Adding a new address always has a
// 24-hour timelock UNLESS the user has pre-set "instant whitelist mode for
// <= $50" and the amount fits the limit. On any add, a push/email alert is sent.
model AddressWhitelist {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address          String
  label            String?
  timelockUntil    DateTime? // null means no pending timelock (already active)
  isInstantApproved Boolean @default(false) // true if whitelisted with instant mode
  instantLimitUsd  Decimal? @db.Decimal(10, 2) // max USD for instant whitelist
  createdAt        DateTime @default(now())
  activatedAt      DateTime?

  @@unique([userId, address])
  @@index([userId])
  @@index([address])
}

// ─── Asset Withdrawal Config ─────────────────────────────────────────────────

// Per-asset withdrawal configuration: minConfirmations, etc.
// Native XLM (low-confidence) can require higher confirmations; USDC (stable)
// can use lower.
model AssetWithdrawalConfig {
  id                String   @id @default(uuid())
  assetId           String   @unique
  asset             Asset    @relation(fields: [assetId], references: [id])
  minConfirmations  Int      @default(5)
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([assetId])
}

// ─── Interest Rate Models ────────────────────────────────────────────────────

model AssetInterestState {
  assetId           String   @id
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  borrowIndex       Decimal  @default(1.0) @db.Decimal(28, 9)
  supplyIndex       Decimal  @default(1.0) @db.Decimal(28, 9)
  lastAccrualLedger Int      @default(0)
  lastAccrualAt     DateTime @default(now())
  totalSupplied     BigInt   @default(0)
  totalBorrowed     BigInt   @default(0)
  protocolFees      BigInt   @default(0)
  updatedAt         DateTime @updatedAt

  @@index([assetId])
}

model AssetInterestParams {
  assetId          String   @id
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  baseRateBps      Int      @default(0)
  kinkUtilBps      Int      @default(8000)
  slope1Bps        Int      @default(0)
  slope2Bps        Int      @default(0)
  reserveFactorBps Int      @default(1000)
  updatedAt        DateTime @updatedAt

  @@index([assetId])
}
