# Example environment for veilend-mobile
# Copy to `.env` (or set vars in your shell / EAS secrets) before `npx expo start`.
#
# Expo inlines variables prefixed with EXPO_PUBLIC_ at bundle time.

# ---------------------------------------------------------------------------
# Backend API base URL
# ---------------------------------------------------------------------------
# Preferred: single override for every platform (physical device, staging, etc.)
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Or set platform-specific hosts (used when EXPO_PUBLIC_API_URL is unset):
#   web / iOS simulator  -> localhost
#   Android emulator     -> 10.0.2.2 (maps to host machine)
EXPO_PUBLIC_API_URL_WEB=http://localhost:3000
EXPO_PUBLIC_API_URL_MOBILE=http://10.0.2.2:3000

# Physical device tip:
#   1. Find your machine's LAN IP (e.g. ipconfig / ifconfig)
#   2. Ensure the phone and computer share the same Wi-Fi
#   3. Set EXPO_PUBLIC_API_URL=http://<LAN-IP>:3000
#   4. Restart Expo so the new env is inlined

# ---------------------------------------------------------------------------
# Optional: Stellar / feature toggles (app code may adopt these later)
# ---------------------------------------------------------------------------
# STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# APP_ENV=development
