{
  "expo": {
    "name": "mobile-app",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cedarich.veillend.mobileapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your Veillend wallet."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "cedarich.veillend.mobileapp",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Veillend to access Face ID to unlock your wallet."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Veillend to use Face ID to unlock your wallet.",
          "touchIDPermission": "Allow Veillend to use Touch ID / Biometrics to unlock your wallet."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7c799ed6-5da2-48b2-a784-f73925fbd4fa"
      }
    }
  }
}
